local function Tween(obj, time, props, style, dir)
	style = style or Enum.EasingStyle.Quad
	dir = dir or Enum.EasingDirection.Out
	local tw = TweenService:Create(obj, TweenInfo.new(time, style, dir), props)
	tw:Play()
	return tw
end

local function New(class, parent, props)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function Corner(parent, scale)
	return New("UICorner", parent, { CornerRadius = UDim.new(scale or 0.2, 0) })
end

local function Stroke(parent, color, thickness)
	return New("UIStroke", parent, { Color = color or Theme.Stroke, Thickness = thickness or 1 })
end

local function Pad(parent, l, r, t, b)
	return New("UIPadding", parent, {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingBottom = UDim.new(0, b or 0),
	})
end

local function ListLayout(parent, dir, gap, align)
	return New("UIListLayout", parent, {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function AddHover(button, normalColor, hoverColor, time)
	time = time or 0.15
	button.MouseEnter:Connect(function()
		Tween(button, time, { BackgroundColor3 = hoverColor })
	end)
	button.MouseLeave:Connect(function()
		Tween(button, time, { BackgroundColor3 = normalColor })
	end)
	button.MouseButton1Down:Connect(function()
		Tween(button, 0.08, { Size = button.Size - UDim2.new(0, 2, 0, 2) })
	end)
	button.MouseButton1Up:Connect(function()
		Tween(button, 0.08, { Size = button.Size + UDim2.new(0, 2, 0, 2) })
	end)
end

local function MakeDraggable(frame, handle)
	handle = handle or frame
	local dragging = false
	local dragInput, mousePos, framePos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			mousePos = input.Position
			framePos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - mousePos
			frame.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
		end
	end)
end

local function BuildToggle(parent, startOn)
	local btn = New("TextButton", parent, {
		Name = "ToggleBtn",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 42, 0, 22),
	})
	local onFrame = New("Frame", btn, {
		Name = "ON",
		BackgroundColor3 = Theme.On,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = startOn == true,
	})
	Corner(onFrame, 1)
	local onKnob = New("Frame", onFrame, {
		Name = "Knob",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Size = UDim2.new(0.4, 0, 0.72, 0),
		Position = UDim2.new(0.54, 0, 0.14, 0),
	})
	Corner(onKnob, 1)
	New("TextLabel", onFrame, {
		Name = "ToggleON/OFF",
		BackgroundTransparency = 1,
		Text = "ON",
		Font = Enum.Font.GothamBold,
		TextSize = 9,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Position = UDim2.new(0, 4, 0, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local offFrame = New("Frame", btn, {
		Name = "OFF",
		BackgroundColor3 = Theme.Off,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = startOn ~= true,
	})
	Corner(offFrame, 1)
	local offKnob = New("Frame", offFrame, {
		Name = "Knob",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Size = UDim2.new(0.4, 0, 0.72, 0),
		Position = UDim2.new(0.06, 0, 0.14, 0),
	})
	Corner(offKnob, 1)
	New("TextLabel", offFrame, {
		Name = "ToggleON/OFF",
		BackgroundTransparency = 1,
		Text = "OFF",
		Font = Enum.Font.GothamBold,
		TextSize = 9,
		TextColor3 = Color3.fromRGB(230, 230, 230),
		Position = UDim2.new(0.46, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local toggled = startOn == true
	local function set(value, fire)
		toggled = value
		onFrame.Visible = toggled
		offFrame.Visible = not toggled
		if fire and btn.Toggled then
			btn.Toggled(toggled)
		end
	end
	btn.MouseButton1Click:Connect(function()
		set(not toggled, true)
	end)
	return btn, set, function()
		return toggled
	end
end

