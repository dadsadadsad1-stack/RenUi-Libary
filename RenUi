		Tween(Title, 0.3, { TextTransparency = 0 })
		Tween(Content, 0.3, { TextTransparency = 0 })
		Tween(ExitBtn, 0.3, { TextTransparency = 0 })

		task.delay(duration, dismiss)

		return { Instance = Notification, Dismiss = dismiss }
	end

	function Window:CreatePopup(config)
		config = config or {}

		local Popup = New("Frame", ScreenGui, {
			Name = "Popup",
			BackgroundColor3 = Theme.Panel,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 300, 0, 150),
			BorderSizePixel = 0,
			ZIndex = 60,
		})
		Corner(Popup, 0.06)
		Stroke(Popup)

		local PopupScale = New("UIScale", Popup, { Scale = 0.8 })
		Tween(PopupScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)

		local ExitBtn = New("TextButton", Popup, {
			Name = "ExitBtn",
			BackgroundTransparency = 1,
			Text = "X",
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = Theme.SubText,
			Position = UDim2.new(1, -30, 0, 8),
			Size = UDim2.new(0, 22, 0, 22),
		})
		ExitBtn.MouseEnter:Connect(function()
			Tween(ExitBtn, 0.15, { TextColor3 = Color3.fromRGB(220, 90, 90) })
		end)
		ExitBtn.MouseLeave:Connect(function()
			Tween(ExitBtn, 0.15, { TextColor3 = Theme.SubText })
		end)

		local PopupTitle = New("TextLabel", Popup, {
			Name = "PopupTitle",
			BackgroundTransparency = 1,
			Text = config.Title or "Popup",
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextColor3 = Theme.Text,
			Position = UDim2.new(0, 16, 0, 14),
			Size = UDim2.new(1, -50, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Left,
		})

		local PopupContent = New("TextLabel", Popup, {
			Name = "PopupContent",
			BackgroundTransparency = 1,
			Text = config.Content or "",
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			Position = UDim2.new(0, 16, 0, 40),
			Size = UDim2.new(1, -32, 0, 64),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})

		local ButtonRow = New("Frame", Popup, {
			Name = "ButtonRow",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -16, 1, -14),
			Size = UDim2.new(0, 220, 0, 30),
		})
		ListLayout(ButtonRow, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)

		local function close()
			Tween(PopupScale, 0.15, { Scale = 0.8 })
			Tween(Popup, 0.15, { BackgroundTransparency = 1 })
			task.delay(0.15, function()
				Popup:Destroy()
			end)
		end
		ExitBtn.MouseButton1Click:Connect(close)

		for _, btnConfig in ipairs(config.Buttons or {}) do
			local Btn = New("TextButton", ButtonRow, {
				Name = "PopupBtn",
				BackgroundColor3 = btnConfig.Accent and Theme.Accent or Theme.PanelLight,
				Text = btnConfig.Text or "OK",
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = Color3.fromRGB(255, 255, 255),
				Size = UDim2.new(0, 90, 1, 0),
				BorderSizePixel = 0,
			})
			Corner(Btn, 0.2)
			local normalColor = btnConfig.Accent and Theme.Accent or Theme.PanelLight
			local hoverColor = btnConfig.Accent and Color3.fromRGB(171, 122, 255) or Theme.Stroke
			AddHover(Btn, normalColor, hoverColor)
			Btn.MouseButton1Click:Connect(function()
				if btnConfig.Callback then
					btnConfig.Callback()
				end
				close()
			end)
		end

		return { Instance = Popup, Close = close }
	end

	function Window:StartUp(welcomeText)
		PlayLoadingScreen(function()
			if config.EnableKeySystem == true then
				KeySystemAPI:Open()
			else
				SetWindowOpen(true)
			end
			Window:Notify({
				Title = "Welcome",
				Content = welcomeText or ("Welcome back, " .. LocalPlayer.DisplayName .. "!"),
				Duration = 4,
			})
		end)
	end

	function Window:Toggle()
		SetWindowOpen(not MainFrame.Visible)
	end

	function Window:Destroy()
		ScreenGui:Destroy()
	end

	if config.EnableLoadingScreen ~= false then
		PlayLoadingScreen(function()
			if config.WelcomeMessage ~= false then
				Window:Notify({
					Title = "Welcome",
					Content = config.WelcomeMessage or ("Welcome back, " .. LocalPlayer.DisplayName .. "!"),
					Duration = 4,
				})
			end
		end, config.LoadingDuration)
	else
		LoadingScreen.Visible = false
	end

	return Window
end

return VexonLib
