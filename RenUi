	local function ResolveIcon(iconLabel, icon)
		if not icon then
			iconLabel.Visible = false
			return
		end
		iconLabel.Visible = true
		if type(icon) == "string" and icon:match("^rbxassetid://") then
			iconLabel.Image = icon
			iconLabel.ImageRectOffset = Vector2.new(0, 0)
			iconLabel.ImageRectSize = Vector2.new(0, 0)
			return
		end
		if Window.IconProvider then
			local ok, asset = pcall(Window.IconProvider.GetAsset, icon, 24)
			if ok and asset then
				iconLabel.Image = asset.Url
				iconLabel.ImageRectOffset = asset.ImageRectOffset
				iconLabel.ImageRectSize = asset.ImageRectSize
				return
			end
		end
		iconLabel.Image = "rbxassetid://0"
		iconLabel.ImageRectOffset = Vector2.new(0, 0)
		iconLabel.ImageRectSize = Vector2.new(0, 0)
	end
	Window.ResolveIcon = ResolveIcon

